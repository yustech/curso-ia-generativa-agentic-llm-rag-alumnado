# Copia este fichero como .env y ajusta los valores. El .env no se sube a Git.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS o Linux:         cp .env.example .env

# --- Motor de inferencia (cualquier servidor compatible con la API de OpenAI) ---
# Ollama en tu portátil (opción por defecto):
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# LM Studio en tu portátil (Developer > Start Server):
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# Servidor compartido del curso (el docente os dará la URL y la clave de equipo):
# LLM_BASE_URL=http://servidor-curso:11434/v1
# LLM_API_KEY=clave-del-equipo

# --- Modelos ---
# Modelo de chat por defecto: rápido en 16 GB, admite herramientas y JSON Schema.
CHAT_MODEL=granite4:micro
# Alternativas: qwen3:4b (razona antes de responder, más lento) · gemma3:4b (buen español, sin herramientas)
# Modelo de embeddings multilingüe:
EMBED_MODEL=embeddinggemma

# Segundos máximos por llamada
LLM_TIMEOUT=120
